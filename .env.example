# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=knobitz
DB_PASS=
DB_NAME=knobitz

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for all learning content (explanations, practice, tests, Anne chat).
ANTHROPIC_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Optional — email+password signup/login works without these.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional — if unset, emails are logged to console instead of sent.
# Required for: email verification, password reset, billing alerts, child invites.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── App URL ───────────────────────────────────────────────────────────────────
# Used to construct links in emails (e.g. email verification).
# Optional locally if SMTP is not configured.
BASE_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
# Optional — defaults to 3000. SOCKET takes precedence over PORT when set.
PORT=3000
# SOCKET=/var/run/knobitz.sock